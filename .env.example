# Copy to .env. Never commit .env or put secrets in NEXT_PUBLIC_ variables.
# Start in explicit sample mode. Switch to database after migration + seed.
LISTINGS_SOURCE="sample"
SITE_URL="http://localhost:3000"
# Supabase Connect > Transaction pooler (port 6543). URL-encode the password.
DATABASE_URL="postgresql://postgres.ztkihbwbkzaugqymsxpy:ENCODED_PASSWORD@aws-1-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
# Supabase Connect > Session pooler (port 5432); IPv4-friendly for Windows.
# Copy your exact dashboard host; it can differ from the example above.
DIRECT_URL="postgresql://postgres.ztkihbwbkzaugqymsxpy:ENCODED_PASSWORD@aws-1-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Phase 3: OpenAI runs only on the server. Add your own API key locally.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
# database = Supabase; local = development-only files in ignored .pax-data/.
# Listing search always uses the five samples in Phase 3, regardless of this setting.
PAX_STORAGE="database"
# Paul notifications: off, both (Resend + Twilio), email, or sms. Lead acknowledgments require channel consent.
PAX_NOTIFICATIONS="off"
PAX_AGENT_EMAIL="exppbc@gmail.com"
PAX_AGENT_PHONE="+15612557285"
RESEND_API_KEY=""
RESEND_FROM=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Phase 3: set both only after Twilio and Resend are configured.
# PAX_NOTIFICATIONS supports off, preview (development), email, sms, both.
FACEBOOK_APP_SECRET=""
FACEBOOK_VERIFY_TOKEN=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""
FACEBOOK_FORM_IDS=""
# Choose a supported version in your Meta app dashboard.
FACEBOOK_GRAPH_VERSION="v24.0"
FACEBOOK_INTEREST_FIELD="looking_for"
FACEBOOK_TIMELINE_FIELD="timeline"
FACEBOOK_SMS_CONSENT_FIELD="sms_consent"
FACEBOOK_EMAIL_CONSENT_FIELD="email_consent"
