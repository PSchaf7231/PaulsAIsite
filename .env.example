# Copy to .env. Never commit .env or put secrets in NEXT_PUBLIC_ variables.
# Start in explicit sample mode. Switch to database after migration + seed.
LISTINGS_SOURCE="sample"
SITE_URL="http://localhost:3000"
# Supabase Connect > Transaction pooler (port 6543). URL-encode the password.
DATABASE_URL="postgresql://postgres.ztkihbwbkzaugqymsxpy:ENCODED_PASSWORD@aws-1-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
# Supabase Connect > Session pooler (port 5432); IPv4-friendly for Windows.
# Copy your exact dashboard host; it can differ from the example above.
DIRECT_URL="postgresql://postgres.ztkihbwbkzaugqymsxpy:ENCODED_PASSWORD@aws-1-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Phase 2: OpenAI runs only on the server. Add your own API key locally.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
# database = Supabase; local = development-only files in ignored .pax-data/.
# Listing search always uses the five samples in Phase 2, regardless of this setting.
PAX_STORAGE="database"
# Paul notifications: off, email (Resend), or sms (Twilio). Never visitor marketing.
PAX_NOTIFICATIONS="off"
PAX_AGENT_EMAIL="paul@palmbeachrealestatepros.com"
PAX_AGENT_PHONE="+15612557285"
RESEND_API_KEY=""
RESEND_FROM=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
