generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ListingType {
  SALE
  RENT
  COMMERCIAL
}

model Listing {
  id String @id @default(cuid())
  slug String @unique
  title String
  address String
  city String
  postalCode String
  price Int
  beds Int
  baths Float
  sqft Int
  latitude Float
  longitude Float
  type ListingType @default(SALE)
  status String @default("ACTIVE")
  description String
  features String[]
  source String @default("AGENT")
  attribution String?
  isSample Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photos ListingPhoto[]

  @@index([status, type, city, price])
}

model ListingPhoto {
  id String @id @default(cuid())
  listingId String
  url String
  alt String
  position Int @default(0)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}


model PaxConversation {
  id String @id
  data Json
  leaseToken String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead PaxLead?
}

model PaxLead {
  id String @id
  conversationId String @unique
  conversation PaxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  name String?
  email String?
  phone String?
  source String @default("WEBSITE")
  stage String @default("NEW_LEAD")
  preferences Json
  createdAt DateTime @default(now())
  appointments PaxAppointment[]
  searches PaxSavedSearch[]
}

model PaxAppointment {
  id String @id
  leadId String
  lead PaxLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind String
  preferredTime String
  status String @default("REQUESTED")
  confirmedAt DateTime?
  createdAt DateTime @default(now())
}

model PaxSavedSearch {
  id String @id
  leadId String
  lead PaxLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  preferences Json
  status String @default("SAMPLE_ONLY")
  createdAt DateTime @default(now())
}
